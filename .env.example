# Copy to .env and fill in. .env is gitignored; never commit a real key.
EVDS_API_KEY=your-evds-api-key

# Optional: store data in Postgres/Supabase instead of the local SQLite file.
# Session pooler string (port 5432) of the least-privilege fetch_writer role. The owner string
# (postgres.<project-ref>) stays in your password manager; it is only for `db migrate`.
# DATABASE_URL=postgresql://fetch_writer.<project-ref>:<password>@<pooler-host>:5432/postgres

# Optional overrides. Defaults live under the project's data/ folder;
# relative paths here are resolved from the current working directory.
# DB_PATH=C:/path/to/tr_banking.db
# RAW_DIR=C:/path/to/raw
